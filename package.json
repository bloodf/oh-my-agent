{
	"name": "@bloodf/oh-my-agent",
	"version": "1.5.1",
	"type": "module",
	"description": "OMP plugin for autonomous long-lived multi-agent collaboration",
	"license": "MIT",
	"keywords": [
		"omp",
		"oh-my-pi",
		"agents",
		"multi-agent",
		"automation"
	],
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/bloodf/oh-my-agent.git"
	},
	"homepage": "https://github.com/bloodf/oh-my-agent#readme",
	"bugs": "https://github.com/bloodf/oh-my-agent/issues",
	"engines": {
		"bun": ">=1.3.14"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"omp-agent": "src/daemon/main.ts"
	},
	"files": [
		"package.json",
		"src",
		"skills",
		"LICENSE",
		"CHANGELOG.md",
		"README.md"
	],
	"peerDependencies": {
		"@oh-my-pi/pi-ai": "^18.1.0",
		"@oh-my-pi/pi-coding-agent": "^18.1.0",
		"@oh-my-pi/pi-utils": "^18.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@oh-my-pi/pi-ai": "^18.1.17",
		"@oh-my-pi/pi-coding-agent": "^18.1.17",
		"@oh-my-pi/pi-utils": "^18.1.17",
		"@types/bun": "latest",
		"puppeteer-core": "^25.9.0",
		"typescript": "latest"
	},
	"scripts": {
		"typecheck": "tsc --noEmit && bun run --cwd web typecheck && bun run --cwd web-next typecheck",
		"console:dev": "bun run --cwd web dev",
		"console:build": "bun run --cwd web build",
		"console:next:dev": "bun run --cwd web-next dev",
		"console:next:build": "bun run --cwd web-next build",
		"console:next:start": "bun run --cwd web-next start",
		"prepack": "bun run console:build && bun run typecheck && bun run test:fast",
		"test": "bun test --timeout 30000",
		"test:fast": "bun test --timeout 30000 --path-ignore-patterns 'tests/pack.test.ts' --path-ignore-patterns 'tests/consumer-install.test.ts' --path-ignore-patterns 'tests/console-client.test.ts' --path-ignore-patterns 'tests/console-next.test.ts'",
		"test:consumer-install": "bun test --timeout 30000 tests/consumer-install.test.ts",
		"lint": "biome check .",
		"format": "biome check --write .",
		"docs": "python3 scripts/gen-delivery-docs.py",
		"storybook": "bun storybook/console/serve.ts",
		"changelog:notes": "bun scripts/cut-changelog.ts notes",
		"changelog:cut": "bun scripts/cut-changelog.ts cut"
	},
	"omp": {
		"name": "oh-my-agent",
		"version": "1.5.1",
		"description": "OMP plugin for autonomous long-lived multi-agent collaboration",
		"extensions": [
			"src/extension/index.ts"
		]
	}
}
